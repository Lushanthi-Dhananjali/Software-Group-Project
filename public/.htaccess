# Define the default document to serve when loading a directory
DirectoryIndex index.html

# Prevent folder directory listing (resolves Forbidden errors if index.html is temporarily missing or during navigation)
Options -Indexes

# Force correct MIME types for modern JavaScript module files and styles
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType text/css .css
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Route any /api/... requests to the PHP database bridge
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]
  
  # If the requested file or directory exists on the server, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Otherwise, redirect all other requests to index.html so React can handle client-side routing
  RewriteRule ^ index.html [L]
</IfModule>
